{
	"name": "autocraftofexile",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"main": "src/electron.cjs",
	"scripts": {
		"dev": "cross-env NODE_ENV=dev bun run dev:all",
		"dev:all": "concurrently -n=svelte,electron -c='#ff3e00',blue \"bun run dev:svelte\" \"bun run dev:electron\"",
		"dev:svelte": "vite dev",
		"dev:electron": "electron src/electron.cjs",
		"build": "cross-env NODE_ENV=production bun run build:svelte && bun run build:electron",
		"build:svelte": "vite build",
		"build:electron": "electron-builder -mwl --config build.config.json",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write ."
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@skeletonlabs/skeleton": "^5.0.1",
		"@skeletonlabs/skeleton-svelte": "^5.0.1",
		"@surdeddd/wmkit": "^0.11.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"concurrently": "^10.0.5",
		"cross-env": "^10.1.0",
		"electron": "^43.4.0",
		"electron-builder": "^26.15.3",
		"electron-context-menu": "^4.1.2",
		"electron-reloader": "^1.2.3",
		"electron-serve": "^3.0.1",
		"electron-updater": "^6.8.9",
		"electron-window-state": "^5.0.3",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"allowScripts": {
		"electron": true
	}
}
